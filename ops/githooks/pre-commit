#!/usr/bin/env bash
# 🎯 augur pre-commit — 把「已寫好但不會自己跑」的機械閘接上唯一會自動觸發的地方。
#
# 為何存在（2026-07-31）：單一角色整併後，`#8` 隔離之 DB 層已不存在且原理上無法重建
# （單一角色 owner 無法 REVOKE 自己）。AST 字面稽核成為**唯一**的機械防線，
# 而它在此之前 `.git/hooks` 非 sample 檔＝0、無 CI、無 cron ⇒ 只在有人手動想到時才跑。
# r2 債 #6 逐字：「四個真有價值的機械閘全部『存在但不會自己跑』」。
#
# 紀律：純 shell、零新依賴（不引入 pre-commit 框架，守 #28 本地優先）。
# 射程誠實：只掛「現況為綠且可重跑」之三閘；`constitution_lint --selftest` 現為 rc=1
# （G10 界線 FAIL、屬治權解釋待裁）**刻意不掛**——掛了會使 repo 立即不可 commit。
# 換機注意：.git/hooks 不隨 git 走，須由 `python3 scripts/install_git_hooks.py --apply` 安裝
#   （resume_project.sh:53-54 已串於一鍵接續；2026-08-03 M-G1 S3 更正——舊註記之
#    install_services.sh 早已不負責 hook 安裝，照舊註記操作會裝不上）。
set -uo pipefail
# ── M-G1（2026-08-03）：worktree 雙失效之修補 ────────────────────────────────
# 病：worktree 內 `--show-toplevel` 指向 worktree 根，其下無 venv ⇒ 舊碼 `exit 0`
#     ＝**靜默放行**；且 worktree 停在舊 commit，連本 hook 檔都可能不存在（bash 找不到
#     檔案同樣 rc=0）。本輪 r4 深讀之四路產出全在 worktree 完成、每筆 commit 零閘。
# 修：ROOT 改由 --git-common-dir 推導（worktree 亦指回主庫），且**找不到直譯器一律
#     fail-closed（exit 1）**——閘的存在理由就是「不確定時擋下」，不是「找不到就放行」。
COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null || echo '')"
if [ -n "$COMMON_DIR" ]; then
  ROOT="$(cd "$COMMON_DIR/.." && pwd)"          # .git/.. ＝主庫工作樹根（worktree 亦然）
else
  ROOT="$(git rev-parse --show-toplevel)"
fi
PY="$ROOT/venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "pre-commit: 找不到 $PY —— **fail-closed 擋下**（不是略過）。" >&2
  echo "  修法：於主庫跑 pip install -e .；確認 $ROOT 為主庫根。" >&2
  echo "  若確需繞過（會留在 reflog）：git commit --no-verify" >&2
  exit 1
fi
cd "$ROOT" || exit 1
fail=0
run() {  # run <名稱> <指令…>
  local name="$1"; shift
  if ! out=$("$@" 2>&1); then
    echo "✗ pre-commit [$name] 失敗："; echo "$out" | tail -12; fail=1
  else
    echo "✓ $name"
  fi
}
run "治權引用稽核"   "$PY" scripts/check_treaty_refs.py
run "執行指令矩陣"   "$PY" scripts/check_cmd_matrix.py
run "#8 隔離 AST 閘" "$PY" -c "from augur.audit.import_isolation import check_isolation; v=check_isolation(); assert not v, v"
# 第四閘(登錄冊 C3 2026-08-01):恆真自測斷言不得入庫——只擋基線外新增(存量 20 條清償制,
# 基線=ops/false_assertion_baseline.txt);實測 0.6s。射程=型1自我匹配+型2字面另有出處。
run "假斷言閘"       "$PY" scripts/check_false_assertions.py --gate
# 第五閘(WM.36 止血 2026-08-02,G0 格6 准先行):vendor 表名直綁凍結——新增檔/新表/增處即紅(存量
# 128 條指紋清償制,基線=ops/vendor_binding_baseline.txt);實測 0.3s。口徑=FROM quoted CamelCase∪跳脫變體∪fred_series。
run "vendor 直綁閘"  "$PY" scripts/check_vendor_binding.py --gate
if [ "$fail" -ne 0 ]; then
  echo ""
  echo "── commit 已中止。修正後重試；確需跳過請 git commit --no-verify（會留在 reflog）。"
  exit 1
fi
exit 0
