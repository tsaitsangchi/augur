{
  "mcpServers": {
    "constitution": {
      "command": "bash",
      "args": ["tools/run_constitution_mcp.sh"]
    },
    "local-llm": {
      "command": "bash",
      "args": ["tools/run_local_llm_mcp.sh"],
      "env": {
        "OLLAMA_URL": "http://127.0.0.1:11434",
        "OLLAMA_TEMPERATURE": "0",
        "OLLAMA_NUM_CTX": "4096",
        "OLLAMA_KEEP_ALIVE": "30s"
      }
    },
    "project-memory": {
      "command": "bash",
      "args": ["tools/run_project_memory_mcp.sh"],
      "env": {
        "OLLAMA_URL": "http://127.0.0.1:11434",
        "EMBED_MODEL": "nomic-embed-text",
        "EMBED_TIMEOUT_S": "180"
      }
    }
  }
}
